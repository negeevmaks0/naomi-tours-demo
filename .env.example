# Telegram bot token from BotFather
BOT_TOKEN=

# Bot username without @
BOT_USERNAME=

# Optional numeric Telegram chat ID for demo notifications
ADMIN_CHAT_ID=

# Public website URL used in bot messages.
# A local address (127.0.0.1 / localhost) works only on this PC: the bot then sends no site links.
# For GitHub Pages: https://<github-user>.github.io/<repo>
SITE_BASE_URL=http://127.0.0.1:8000

# Path prefix when the site is not served from the domain root (GitHub Pages: /<repo>). Empty locally.
SITE_BASE_PATH=

# SQLite database
DATABASE_URL=sqlite:///./data/naomi_tours_demo.db

# Organizer shown on the site (About page and footer) only if set. Leave empty until approved.
ORGANIZER_NAME=
ORGANIZER_CONTACT=

DEMO_MODE=true

# Admin panel (Stage 3). Without ADMIN_PASSWORD the admin panel is disabled.
ADMIN_PASSWORD=
# Random string for signing the admin session cookie: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=

# Auto-publishing to GitHub Pages after tour changes (server): git clone of the Pages repo and its path prefix.
SITE_REPO_DIR=
SITE_PAGES_BASE_PATH=
